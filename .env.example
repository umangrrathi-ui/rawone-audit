# ---------- App ----------
# Public base URL (no trailing slash). Locally: http://localhost:3000
APP_URL=https://audit.rawone.co.in

# ---------- Apify ----------
APIFY_TOKEN=
# Seconds per scrape attempt (1 retry happens automatically)
APIFY_TIMEOUT_SECS=40

# ---------- OpenAI ----------
OPENAI_API_KEY=
# Free report model. Switch to gpt-6.1-sol if luna findings feel generic.
OPENAI_MODEL=gpt-6-luna
# ₹299 deep report model
OPENAI_DEEP_MODEL=gpt-6.1-sol

# ---------- Supabase (server-side only, never expose) ----------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---------- WhatsApp Cloud API ----------
WA_PHONE_NUMBER_ID=
# System User permanent token
WA_TOKEN=
# Any random string, same value in Meta webhook config
WA_VERIFY_TOKEN=
# App Secret (Meta app → Settings → Basic). Used to verify X-Hub-Signature-256. Strongly recommended.
WA_APP_SECRET=
# Graph API version
WA_API_VERSION=v23.0
# Business number in international format, digits only (used for wa.me links). e.g. 9198XXXXXXXX
WA_BUSINESS_NUMBER=
# Approved utility template name + language (used when user's 24h window is closed)
WA_TEMPLATE_NAME=audit_report_ready
WA_TEMPLATE_LANG=en

# ---------- Team alerts ----------
# Digits only, with country code. This number must message the bot once every 24h to keep window open.
ALERT_WA_NUMBER=
# Optional: n8n webhook URL — gets every alert as JSON (use it to email/Sheet/Slack). More reliable than WA.
ALERT_WEBHOOK_URL=

# ---------- Cashfree ----------
CASHFREE_APP_ID=
CASHFREE_SECRET=
# sandbox | production
CASHFREE_ENV=sandbox
CASHFREE_API_VERSION=2025-01-01
# Temporarily set to 1 for the live ₹1 test
PRICE_INR=299

# ---------- Limits ----------
# Lifetime free audits per Instagram handle and per WhatsApp number (same handle within 24h reopens the old report)
AUDIT_LIMIT_PER_HANDLE=2
AUDIT_LIMIT_PER_NUMBER=2

# ---------- Admin ----------
# Long random string. Lead list: https://audit.rawone.co.in/admin?key=THIS_VALUE
ADMIN_KEY=

# ---------- CTAs ----------
# Free strategy call link (Calendly / Cal.com / wa.me). Falls back to WhatsApp chat.
STRATEGY_CALL_URL=
